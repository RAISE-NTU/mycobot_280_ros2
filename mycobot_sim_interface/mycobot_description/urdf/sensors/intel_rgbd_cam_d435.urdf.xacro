<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="use_camera" default="true"/>
  <xacro:arg name="use_gazebo" default="true"/>
  <xacro:arg name="prefix" default=""/>

  <!--
    Image size and clip range.

    The previous fixed 424x240 is a D435 *depth* mode, and at the ~0.5 m
    working distance of the calibration rig it puts a 40 mm ArUco marker on
    roughly 22 px. Corner localisation is quantised at about 1.8 mm per pixel
    there, which dominates every other error term in the hand-eye solve.
    848x480 is a native D435 colour mode and halves that to ~0.9 mm/px while
    costing far less render time than 1280x720 at the same field of view.

    The far clip was 1.5 m, which is enough for the marker but clips the table
    and background out of the depth image; 3.0 m keeps the scene intact.
  -->
  <xacro:arg name="camera_width" default="848"/>
  <xacro:arg name="camera_height" default="480"/>
  <xacro:arg name="camera_hfov" default="1.5184"/>
  <xacro:arg name="camera_near_clip" default="0.05"/>
  <xacro:arg name="camera_far_clip" default="3.0"/>
  <xacro:arg name="camera_update_rate" default="5"/>

  <!--
    Where the camera looks.

    These were previously fixed at tilt 25 deg, pan 0, which aims the optical
    axis along base +Y and 25 deg down. The robot's reachable workspace is a
    sphere of radius ~0.26 m about (0, 0, 0.13), and from the stand at
    (0.22, -0.29, 0.50) that sphere lies 45 deg down and 37 deg to the side.
    With the old aim it projected to a disc centred on pixel (189, 466) of an
    848x480 image: the bottom-left corner, with more than half of it outside
    the frame entirely.

    That matters for calibration specifically. A hand-eye dataset is supposed
    to put the target across the whole image, edges included, because corner
    localisation and lens distortion both vary across the field and a fit made
    from one patch is only trustworthy in that patch. No pose-planning
    strategy can place the target in image regions the arm cannot reach, so
    the aim has to be fixed first.

    The defaults below point the camera at the middle of the workspace. Pass
    camera_tilt_deg:=25 camera_pan_deg:=0 to restore the previous framing.
  -->
  <xacro:arg name="camera_tilt_deg" default="45.0"/>
  <xacro:arg name="camera_pan_deg" default="37.0"/>

  <xacro:if value="${'true' == '$(arg use_camera)' and 'true' == '$(arg use_gazebo)'}">

    <xacro:property name="M_PI" value="3.1415926535897931" />

    <xacro:property name="d435_cam_width" value="0.090"/>
    <xacro:property name="d435_cam_height" value="0.025"/>
    <xacro:property name="d435_cam_depth" value="0.02505"/>

    <xacro:property name="d435_cam_depth_to_infra1_offset" value="0.0"/>
    <xacro:property name="d435_cam_depth_to_infra2_offset" value="-0.050"/>
    <xacro:property name="d435_cam_depth_to_color_offset" value="0.015"/>

    <xacro:property name="camera_tilt_angle_deg" value="$(arg camera_tilt_deg)"/>
    <xacro:property name="camera_pan_angle_deg" value="$(arg camera_pan_deg)"/>

    <link name="torso_link">
      <inertial>
        <origin xyz="0 0 0.50" />
        <mass value="2.5" />
        <inertia ixx="0.8" ixy="0.0" ixz="0.0" iyy="0.8" iyz="0.0" izz="0.8" />
      </inertial>
      <visual name="holder">
        <origin xyz="0 0 0.25" rpy="0 0 0" />
        <material name="LightGrey">
          <color rgba="0.7 0.7 0.7 1.0"/>
        </material>
        <geometry>
          <cylinder radius="0.005" length="0.5"/>
        </geometry>
      </visual>
      <visual name="base">
        <origin xyz="0 0 0.03" rpy="0 0 0" />
        <material name="LightGrey">
          <color rgba="0.7 0.7 0.7 1.0"/>
        </material>
        <geometry>
          <box size="0.15 0.10 0.06" />
        </geometry>
      </visual>
      <collision name="holder">
        <origin xyz="0 0 0.25" rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.005" length="0.5"/>
        </geometry>
      </collision>
      <collision name="base">
        <origin xyz="0 0 0.03" rpy="0 0 0" />
        <geometry>
          <box size="0.15 0.10 0.06" />
        </geometry>
      </collision>
    </link>

    <joint name="$(arg prefix)base_link_to_torso_link" type="fixed">
      <parent link="$(arg prefix)base_link"/>
      <child link="torso_link"/>
      <origin xyz="0.22 -0.30 0" rpy="0 0 0"/>
    </joint>

    <joint name="camera_head_joint" type="fixed">
      <parent link="torso_link"/>
      <child link="camera_head_link" />
      <origin xyz="0 0.01 0.50"
              rpy="0.0 ${camera_tilt_angle_deg * M_PI / 180}
                   ${M_PI/2 + camera_pan_angle_deg * M_PI / 180}"/>
    </joint>

    <link name="camera_head_link">
      <visual>
        <origin xyz="0 0 0" rpy="${M_PI/2} 0.0 ${M_PI/2}"/>
        <geometry>
          <mesh filename="file://$(find mycobot_description)/meshes/d435/visual/d435.stl" />
        </geometry>
        <material name="aluminum">
          <color rgba="0.5 0.5 0.5 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${d435_cam_depth} ${d435_cam_width} ${d435_cam_height}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.072" />
        <origin xyz="0 0 0" />
        <inertia ixx="0.003881243" ixy="0.0" ixz="0.0" iyy="0.000498940" iyz="0.0" izz="0.003879257" />
      </inertial>
    </link>

    <joint name="camera_head_depth_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="camera_head_link"/>
      <child link="camera_head_depth_frame" />
    </joint>
    <link name="camera_head_depth_frame"/>

    <joint name="camera_head_depth_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}" />
      <parent link="camera_head_depth_frame" />
      <child link="camera_head_depth_optical_frame" />
    </joint>
    <link name="camera_head_depth_optical_frame"/>

    <joint name="camera_head_infra1_joint" type="fixed">
      <origin xyz="0 ${d435_cam_depth_to_infra1_offset} 0" rpy="0 0 0" />
      <parent link="camera_head_link" />
      <child link="camera_head_infra1_frame" />
    </joint>
    <link name="camera_head_infra1_frame"/>

    <joint name="camera_head_infra1_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}" />
      <parent link="camera_head_infra1_frame" />
      <child link="camera_head_infra1_optical_frame" />
    </joint>
    <link name="camera_head_infra1_optical_frame"/>

    <joint name="camera_head_infra2_joint" type="fixed">
      <origin xyz="0 ${d435_cam_depth_to_infra2_offset} 0" rpy="0 0 0" />
      <parent link="camera_head_link" />
      <child link="camera_head_infra2_frame" />
    </joint>
    <link name="camera_head_infra2_frame"/>

    <joint name="camera_head_infra2_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}" />
      <parent link="camera_head_infra2_frame" />
      <child link="camera_head_infra2_optical_frame" />
    </joint>
    <link name="camera_head_infra2_optical_frame"/>

    <joint name="camera_head_color_joint" type="fixed">
      <origin xyz="0 ${d435_cam_depth_to_color_offset} 0" rpy="0 0 0" />
      <parent link="camera_head_link" />
      <child link="camera_head_color_frame" />
    </joint>
    <link name="camera_head_color_frame"/>

    <joint name="camera_head_color_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}" />
      <parent link="camera_head_color_frame" />
      <child link="camera_head_color_optical_frame" />
    </joint>
    <link name="camera_head_color_optical_frame"/>

    <gazebo reference="camera_head_link">
      <sensor name="camera_head" type="rgbd_camera">
        <camera>
          <horizontal_fov>$(arg camera_hfov)</horizontal_fov>
          <image>
            <width>$(arg camera_width)</width>
            <height>$(arg camera_height)</height>
          </image>
          <clip>
            <near>$(arg camera_near_clip)</near>
            <far>$(arg camera_far_clip)</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <gz_frame_id>camera_head_link</gz_frame_id>
        <topic>camera_head</topic>
        <update_rate>$(arg camera_update_rate)</update_rate>
        <visualize>true</visualize>
      </sensor>
    </gazebo>

  </xacro:if>
</robot>