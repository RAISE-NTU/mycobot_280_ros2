<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mycobot_hardware_interface</name>
  <version>0.1.0</version>
  <description>
    ros2_control hardware interface for myCobot 280 M5 via USB serial.
    Enables the dual-mode architecture: when use_sim:=false, this plugin
    replaces ign_ros2_control/IgnitionSystem in the ros2_control stack.
  </description>
  <maintainer email="filipe.silva@ntu.ac.uk">Filipe Silva</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <build_depend>libserial-dev</build_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
